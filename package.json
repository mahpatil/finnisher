{
  "name": "finnisher",
  "version": "0.0.4",
  "description": "Personal execution tracking system — threads + sessions",
  "type": "module",
  "bin": {
    "finn": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "install.sh"
  ],
  "scripts": {
    "build": "tsc && cp -r src/db/migrations/. dist/db/migrations/",
    "postinstall": "chmod +x dist/cli/index.js 2>/dev/null || true",
    "dev": "next dev --port 3141 src/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
    "drizzle-orm": "^0.43.0",
    "nanoid": "^5.0.0"
  },
  "optionalDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.0",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
